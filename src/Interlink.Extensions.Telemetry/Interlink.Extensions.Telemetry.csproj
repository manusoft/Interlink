<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Interlink.Extensions.Telemetry</RootNamespace>
    <AssemblyName>Interlink.Extensions.Telemetry</AssemblyName>
    <PackageId>Interlink.Extensions.Telemetry</PackageId>
    <Version>1.7.0</Version>
    <Description>OpenTelemetry-style Activity instrumentation for Interlink mediator requests, streams, and notifications.</Description>
    <Authors>Manojbabu</Authors>
    <PackageTags>interlink mediator telemetry opentelemetry activity diagnostics</PackageTags>
	<PackageProjectUrl>https://manusoft.github.io/Interlink</PackageProjectUrl>
	<RepositoryUrl>https://github.com/manusoft/Interlink-cqrs-library</RepositoryUrl>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<PackageIcon>icon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interlink\Interlink.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Content Include="icon.png" Pack="true" PackagePath="" Condition="Exists('icon.png')" />
	<Content Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
	<Content Include="LICENSE.txt" Pack="true" PackagePath="" Condition="Exists('LICENSE.txt')" />
  </ItemGroup>

</Project>
