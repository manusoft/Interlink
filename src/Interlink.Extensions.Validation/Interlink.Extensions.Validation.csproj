<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Interlink.Extensions.Validation</RootNamespace>
		<AssemblyName>Interlink.Extensions.Validation</AssemblyName>
		<PackageId>Interlink.Extensions.Validation</PackageId>
		<Version>1.6.0</Version>
		<Description>FluentValidation integration for the Interlink mediator library.</Description>
		<Copyright>Copyright © 2025-2026 ManuHub</Copyright>
		<Authors>Manojbabu</Authors>
		<PackageTags>interlink mediator validation fluentvalidation pipeline behavior cqrs</PackageTags>
		<PackageProjectUrl>https://manusoft.github.io/Interlink</PackageProjectUrl>
		<RepositoryUrl>https://github.com/manusoft/Interlink-cqrs-library</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.*"  Condition="'$(TargetFramework)' != 'netstandard2.0'"/>
		<PackageReference Include="FluentValidation" Version="11.*"  Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Interlink\Interlink.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="icon.png" Pack="true" PackagePath="" Condition="Exists('icon.png')"/>
		<Content Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')"/>
		<Content Include="LICENSE.txt" Pack="true" PackagePath="" Condition="Exists('LICENSE.txt')"/>
	</ItemGroup>

</Project>
