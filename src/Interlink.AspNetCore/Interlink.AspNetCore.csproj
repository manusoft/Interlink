<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Interlink.AspNetCore</RootNamespace>
		<AssemblyName>Interlink.AspNetCore</AssemblyName>
		<PackageId>Interlink.AspNetCore</PackageId>
		<Version>1.6.0</Version>
		<Description>ASP.NET Core integration for the Interlink mediator library (filters, exception handling, helpers).</Description>
		<Copyright>Copyright © 2025-2026 ManuHub</Copyright>
		<Authors>Manojbabu</Authors>
		<PackageTags>interlink mediator aspnetcore filters cqrs</PackageTags>
		<PackageProjectUrl>https://manusoft.github.io/Interlink</PackageProjectUrl>
		<RepositoryUrl>https://github.com/manusoft/Interlink-cqrs-library</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Interlink\Interlink.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="icon.png" Pack="true" PackagePath="" Condition="Exists('icon.png')"/>
		<Content Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')"/>
		<Content Include="LICENSE.txt" Pack="true" PackagePath="" Condition="Exists('LICENSE.txt')"/>
	</ItemGroup>

</Project>
